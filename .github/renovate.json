{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "baseBranches": ["main"],
  "enabled": true,
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["docker-compose"],
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["postgres", "redis"],
      "enabled": false
    }
  ]
}